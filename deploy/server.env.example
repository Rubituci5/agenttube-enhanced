# Copy to /etc/agenttube/agenttube.env, chmod 600, owner root.
# Never commit this file or expose it through nginx.
NODE_ENV=production
DEPLOYMENT_MODE=server
HOST=127.0.0.1
PORT=3456
PUBLIC_ORIGIN=https://iagora.example.com

# Generate: openssl rand -hex 32 (different unique value for each key).
API_KEY=REPLACE_WITH_64_CHAR_RANDOM_HEX
DASHBOARD_BASIC_USER=agenttube
DASHBOARD_BASIC_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Keep pre-migration safe until approvals and end-to-end dry-run pass.
MAX_CONCURRENT_JOBS=1
DAILY_GENERATION_TARGET=1
# Publication is controlled by the DB setting auto_publish_enabled=false.
DEFAULT_PRIVACY_STATUS=private
AUTOMATION_TIMEZONE=America/Sao_Paulo

# Node and video tools installed via apt / nvm-independent NodeSource.
FFMPEG_PATH=/usr/bin/ffmpeg
FFPROBE_PATH=/usr/bin/ffprobe

# Native neural voice; a Linux venv must be installed on the VPS.
KOKORO_TTS_ENABLED=true
KOKORO_PYTHON=/opt/agenttube/data/models/kokoro/venv/bin/python
LOCAL_MAC_TTS=false
ELEVENLABS_TTS_ENABLED=false
BACKGROUND_MUSIC_ENABLED=true

# OAuth ChatGPT tokens are copied separately and must be verified online.
CHATGPT_PLAN_ENABLED=true

# Optional METRED text fallback. OFF until operator approves API billing.
# TEXT_FALLBACK_PROVIDER=gemini
# GEMINI_API_KEY=YOUR_GOOGLE_AI_STUDIO_API_KEY
# GEMINI_TEXT_FALLBACK_MODEL=gemini-2.5-flash-lite

# After verified rollout only:
# DAILY_GENERATION_TARGET=2
# PUBLISH_SLOTS=12:00,19:00


# Turn on ONLY after fact checks, test publishing and review policy are approved:
# DAILY_GENERATION_TARGET=2
# DB setting max_daily_posts=2
# DB setting approval_required=true until fully verified
# DB setting auto_publish_enabled=false until fully verified
